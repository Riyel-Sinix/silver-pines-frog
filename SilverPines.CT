// PlayerMainInventory.RemoveMoney: skip "m_money -= amount"
assert(SP_MONEY, 29 BB 00 01 00 00)
SP_MONEY:
  db 90 90 90 90 90 90

[DISABLE]
SP_MONEY:
  db 29 BB 00 01 00 00
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>10</ID>
          <Description>"金钱（双击右边的数值可以直接改，读档后显示 ?? 属正常）"</Description>
