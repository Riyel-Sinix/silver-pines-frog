// CharacterInventory.Update: charge -= drainRate * deltaTime  ->  charge unchanged
assert(SP_POWER, F3 0F 5C F0)
SP_POWER:
  db 90 90 90 90

[DISABLE]
SP_POWER:
  db F3 0F 5C F0
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>9</ID>
          <Description>"花钱不减少（投币、买东西钱不变）"</Description>
