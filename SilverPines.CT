<?xml version="1.0" encoding="utf-8"?>
<CheatTable CheatEngineTableVersion="42">
  <CheatEntries>
    <CheatEntry>
      <ID>0</ID>
      <Description>"【先勾这个】激活  Silver Pines 修改器"</Description>
      <Options moHideChildren="1" moDeactivateChildrenAsWell="1"/>
      <Color>0000C0</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
-- Silver Pines (Unity 6000.3.15f1, IL2CPP) / Carpenter.exe
-- Static compatibility checked against the Steam build on 2026-10-19 (metadata v39).
-- Resolves every address by signature and validates IL2CPP class names before anything is written.
local MOD = 'GameAssembly.dll'
if getOpenedProcessID() == 0 or getAddressSafe(MOD) == nil then
  error('没找到 GameAssembly.dll：请先点 CE 左上角的电脑图标打开 Carpenter.exe 进程，等游戏进到主菜单再勾选。')
end

SP = SP or {}
SP.pid = getOpenedProcessID()
SP.want = {}

local function scan(tag, aob)
  local a = AOBScanModuleUnique(MOD, aob, '+X')
  if a == nil or a == 0 then
    error('特征码没找到（' .. tag .. '）：游戏版本可能和本表不一致。')
  end
  return a
end
local function rip(ins, dispOff, insLen)  -- target of a RIP-relative operand
  return ins + insLen + readInteger(ins + dispOff, true)
end
local function reg(sym, addr)
  unregisterSymbol(sym)
  registerSymbol(sym, addr, true)
end

SP.slot = {
  GDC = { name = 'GameDebugCommands', addr = rip(scan('GameDebugCommands', '48 8B 05 ?? ?? ?? ?? 0F 57 FF C7 84 24 88 00 00 00 00 00 00 00 C7 44 24 30 00 00 00 00 48 8B 88 B8 00 00 00 80 79 03 00'), 3, 7) },
  GR  = { name = 'GlobalReferences',  addr = rip(scan('GlobalReferences', '48 8B 05 ?? ?? ?? ?? 0F 11 44 24 20 48 8B 88 B8 00 00 00 48 8B 19 48 8B 0D'), 3, 7) },
  CH  = { name = 'CharacterHealth',   addr = rip(scan('CharacterHealth', '48 8B 05 ?? ?? ?? ?? 45 32 ED 44 8B A3 AC 00 00 00 44 39 B8 E4 00 00 00'), 3, 7) },
}

-- CharacterHealth.ApplyDamageInstance, right after "if (GameUtils.IsPlayer(gameObject))"
local ohk = scan('一击必杀', '84 C0 74 56 48 8B 05 ?? ?? ?? ?? 48 8B 88 B8 00 00 00 44 38 79 04 0F 85 ?? ?? ?? ?? 44 38 BB B0 00 00 00')
if rip(ohk + 4, 3, 7) ~= SP.slot.GDC.addr then
  error('一击必杀注入点校验失败：游戏版本可能和本表不一致。')
end

reg('SP_GDC_TI', SP.slot.GDC.addr)
reg('SP_GR_TI',  SP.slot.GR.addr)
reg('SP_OHK',    ohk)
reg('SP_OHK_NP', ohk + 4 + 0x56)  -- the original "not the player" branch target
reg('SP_DUR1',   scan('近战耐久1', 'F3 0F 10 43 60 F3 0F 5C C6 F3 0F 5F C2 0F 2F D0 F3 0F 11 43 60') + 5)
reg('SP_DUR2',   scan('近战耐久2', 'F3 0F 10 43 60 F3 0F 5C C6 F3 0F 5F C1 0F 2F C8 F3 0F 11 43 60') + 5)
reg('SP_POWER',  scan('电量', 'F3 41 0F 59 C0 F3 0F 5C F0 45 33 C0 0F 28 CE 48 8B CF E8') + 5)
reg('SP_MONEY',  scan('金钱', '85 FF 7E 51 29 BB 00 01 00 00') + 4)

-- Static-field block of an IL2CPP class, or nil until the game has initialised that class.
function SP.statics(key)
  local s = SP.slot and SP.slot[key]
  if s == nil or getOpenedProcessID() ~= SP.pid then return nil end
  local klass = readPointer(s.addr)
  if klass == nil or klass == 0 or klass % 2 == 1 then return nil end
  local np = readPointer(klass + 0x10)
  if np == nil or np == 0 or readString(np, 64) ~= s.name then return nil end
  local sf = readPointer(klass + 0xB8)
  if sf == nil or sf == 0 then return nil end
  return sf
end

-- Writes every requested flag; flags whose class is not initialised yet stay queued for the timer.
function SP.apply()
  for k, w in pairs(SP.want) do
    local sf = SP.statics(w.key)
    if sf ~= nil then
      writeBytes(sf + w.off, w.val)
      if w.val == 0 then SP.want[k] = nil end
    end
  end
end

function SP.flag(key, off, on)
  SP.want[key .. ':' .. off] = { key = key, off = off, val = on and 1 or 0 }
  SP.apply()
end

if SP.timer ~= nil then SP.timer.destroy() end
SP.timer = createTimer(nil, false)
SP.timer.Interval = 250
SP.timer.OnTimer = function() pcall(SP.apply) end
SP.timer.Enabled = true
{$asm}

[DISABLE]
{$lua}
if syntaxcheck then return end
if SP ~= nil and SP.timer ~= nil then
  SP.timer.destroy()
  SP.timer = nil
end
{$asm}
</AssemblerScript>
      <CheatEntries>
        <CheatEntry>
          <ID>1</ID>
          <Description>"无敌（敌人、陷阱、迷雾都伤不到你）"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if SP == nil or SP.flag == nil then error('请先勾选最上面的“激活”') end
SP.flag('GDC', 4, true)   -- GameDebugCommands.CHEAT_INVINCIBLE
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if SP ~= nil and SP.flag ~= nil then SP.flag('GDC', 4, false) end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>2</ID>
