        </CheatEntry>
        <CheatEntry>
          <ID>4</ID>
          <Description>"无限弹药（开枪不消耗子弹，不用换弹）"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if SP == nil or SP.flag == nil then error('请先勾选最上面的“激活”') end
SP.flag('GDC', 2, true)   -- GameDebugCommands.CHEAT_INFINITE_AMMO
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if SP ~= nil and SP.flag ~= nil then SP.flag('GDC', 2, false) end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>5</ID>
          <Description>"近战武器不掉耐久（不会坏）"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// MeleeWeaponItemInstance.RemoveDurability and its inlined copy in
// PlayerMainInventory.ApplyDurabilityLossToEquippedItem: drop "durability -= amount"
assert(SP_DUR1, F3 0F 5C C6)
assert(SP_DUR2, F3 0F 5C C6)
SP_DUR1:
  db 90 90 90 90
SP_DUR2:
  db 90 90 90 90

[DISABLE]
SP_DUR1:
  db F3 0F 5C C6
SP_DUR2:
  db F3 0F 5C C6
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>6</ID>
          <Description>"一击必杀（敌人挨一下就死，剧情锁血的敌人不受影响）"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
// CharacterHealth.ApplyDamageInstance: when the damaged character is not the player,
// raise the damage (edi) to 999999. set_Health still clamps to m_minimumHealth.
assert(SP_OHK, 84 C0 74 56 48 8B 05)
alloc(sp_ohk_mem, $100, SP_OHK)
label(sp_ohk_bak)
label(sp_ohk_player)
label(sp_ohk_ret)
registersymbol(sp_ohk_bak)

sp_ohk_mem:
  test al,al
  jne sp_ohk_player
  mov edi,#999999
  jmp SP_OHK_NP
sp_ohk_player:
  mov rax,[SP_GDC_TI]
  jmp sp_ohk_ret

sp_ohk_bak:
  readmem(SP_OHK, 11)

SP_OHK:
  jmp sp_ohk_mem
  nop 6
sp_ohk_ret:

[DISABLE]
SP_OHK:
  readmem(sp_ohk_bak, 11)

unregistersymbol(sp_ohk_bak)
dealloc(sp_ohk_mem)
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
          <ID>7</ID>
          <Description>"必定打中弱点（伤害更高）"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return end
if SP == nil or SP.flag == nil then error('请先勾选最上面的“激活”') end
SP.flag('GDC', 8, true)   -- GameDebugCommands.ALWAYS_WEAKPOINT_HIT
{$asm}
[DISABLE]
{$lua}
if syntaxcheck then return end
if SP ~= nil and SP.flag ~= nil then SP.flag('GDC', 8, false) end
{$asm}
</AssemblerScript>
        </CheatEntry>
        <CheatEntry>
